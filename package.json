{
  "name": "linear-algebra-3d-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-frontend-architecture.mjs && vite build && node scripts/generate-localized-seo-pages.mjs && node scripts/validate-production-routing.mjs",
    "validate:architecture": "node scripts/validate-frontend-architecture.mjs",
    "validate:board-marks": "node scripts/validate-board-annotation.mjs",
    "validate:checkpoint-navigation": "node scripts/validate-checkpoint-navigation.mjs",
    "validate:editor-folding": "node scripts/validate-notebook-folding.mjs",
    "validate:editor-runtime": "node scripts/validate-notebook-editor-runtime.mjs",
    "validate:operation-hud": "node scripts/validate-operation-presentation.mjs",
    "validate:row-ops": "node scripts/validate-row-operation-engine.mjs",
    "validate:lessons": "node scripts/validate-visual-lessons.mjs",
    "validate:deployment": "node scripts/validate-production-routing.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "quality:lessons": "pnpm run validate:board-marks && pnpm run validate:checkpoint-navigation && pnpm run validate:editor-folding && pnpm run validate:editor-runtime && pnpm run validate:operation-hud && pnpm run validate:row-ops && pnpm run validate:lessons && pnpm run build",
    "deploy": "pnpm run deploy:production",
    "deploy:production": "pnpm run build && pnpm run deploy:production:dist && node scripts/verify-production-assets.mjs",
    "deploy:production:dist": "pnpm dlx wrangler pages deploy dist --project-name linear-algebra-lab --branch main --commit-dirty=true",
    "deploy:pages": "pnpm run deploy:production",
    "deploy:pages:dist": "pnpm run deploy:production:dist",
    "backend:dev": "pnpm --dir backend dev",
    "backend:deploy": "pnpm --dir backend run deploy",
    "backend:d1:migrate:local": "pnpm --dir backend d1:migrate:local",
    "backend:d1:migrate:remote": "pnpm --dir backend d1:migrate:remote",
    "backend:typecheck": "pnpm --dir backend typecheck",
    "posthog:log": "node scripts/send-posthog-log.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@posthog/react": "^1.10.3",
    "lucide-react": "^1.17.0",
    "monaco-editor": "^0.55.1",
    "motion": "12.42.2",
    "ogl": "^1.0.11",
    "posthog-js": "^1.395.0",
    "pretendard": "1.3.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-modal-sheet": "5.6.0",
    "sonner": "^2.0.7",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.2",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.16"
  }
}
